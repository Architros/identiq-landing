# Marketing site URL (Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://tryidentiq.com

# Product app base URL (CTAs, legal links)
NEXT_PUBLIC_APP_URL=https://app.tryidentiq.com

# Local dev: point at the main app so pricing proxy can reach /api/billing/plans/public
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# LANDING_PLANS_UPSTREAM_URL=http://localhost:3000

# Optional: copy Supabase vars from the main app .env.local so landing can load plans directly
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
